<!-- Applied only to prod-blog-01. Never edit shared libvirt filters. -->
<filter name='blog-dmz-only' chain='root'>
  <uuid>58032033-f1ef-4bc6-a330-f3c400967e80</uuid>
  <filterref filter='no-mac-spoofing'/>
  <filterref filter='no-ip-spoofing'/>
  <filterref filter='no-arp-spoofing'/>
  <rule action='accept' direction='out' priority='-650'><mac protocolid='ipv4'/></rule>
  <rule action='accept' direction='in' priority='-650'><mac protocolid='ipv4'/></rule>
  <rule action='accept' direction='inout' priority='-500'><mac protocolid='arp'/></rule>
