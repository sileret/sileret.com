[Unit]
Description=Private GoAccess report and traffic spike check

[Service]
Type=oneshot
User=bloganalytics
Group=bloganalytics
SupplementaryGroups=caddy
ExecStart=/usr/local/lib/blog/analytics.py
StateDirectory=blog-analytics
StateDirectoryMode=0750
UMask=0027
Nice=15
CPUQuota=50%
MemoryMax=192M
TimeoutStartSec=5min
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/log/caddy /srv/blog
ReadWritePaths=/var/lib/blog-analytics
